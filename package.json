{
  "name": "pdf-markup",
  "displayName": "PDF Markup",
  "description": "Annotate PDFs right in VS Code: highlight, draw, add text and images, and save them into the file.",
  "version": "2.1.0",
  "publisher": "maxhoelper",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "annotate",
    "annotation",
    "highlight",
    "markup",
    "draw",
    "notes"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1F2A44",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maxhoelper/vscode-pdf-editor.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "customEditors": [
      {
        "viewType": "pdfMarkup.editor",
        "displayName": "PDF Markup",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PDF Markup",
      "properties": {
        "pdf-markup.default.cursor": {
          "markdownDescription": "The default cursor tool.",
          "type": "string",
          "default": "select",
          "enum": [
            "select",
            "hand"
          ]
        },
        "pdf-markup.default.scale": {
          "markdownDescription": "The default zoom level. Allowed values are `auto`, `page-actual`, `page-fit`, `page-width`, and 1-based scale values. (`1.0` means 100%)",
          "type": "string",
          "default": "auto",
          "pattern": "^(\\d+(?:\\.\\d+)?|auto|page-actual|page-fit|page-width)$"
        },
        "pdf-markup.default.sidebar": {
          "markdownDescription": "Show the sidebar on load.",
          "type": "boolean",
          "default": false
        },
        "pdf-markup.default.scrollMode": {
          "markdownDescription": "The default scroll mode.",
          "type": "string",
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped"
          ]
        },
        "pdf-markup.default.spreadMode": {
          "markdownDescription": "The default spread mode.",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "odd",
            "even"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "bugs": {
    "url": "https://github.com/maxhoelper/vscode-pdf-editor/issues"
  },
  "homepage": "https://github.com/maxhoelper/vscode-pdf-editor#readme"
}
